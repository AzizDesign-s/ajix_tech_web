# ---------------------------------------------------------------------------
# AJIX — environment variables
#
# Copy to .env.local for development. Set the same keys in the Vercel project
# settings for production. PLACEHOLDERS ONLY — never commit real values.
#
# Every one of these is optional. If a variable is unset, that integration is
# not loaded and any UI depending on it hides itself rather than rendering a
# dead control. See CONFIGURATION_CHECKLIST.md for the full walkthrough.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------

# Canonical production origin, no trailing slash.
# Drives canonical URLs, Open Graph URLs, the sitemap and JSON-LD.
# Falls back to the Vercel preview domain when unset.
NEXT_PUBLIC_SITE_URL=https://example.com


# --- Contact form (Resend) --------------------------------------------------
# WITHOUT THESE THE FORM CANNOT SEND. It validates, rate-limits and blocks bots,
# then tells the visitor it is not configured — it never claims a message was
# sent. No NEXT_PUBLIC_ prefix on the key: it must never reach the browser.

# resend.com -> API Keys. Sending access is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
CONTACT_TO_EMAIL=you@example.com

# The sender. Must be on a domain you have verified in Resend, or Resend
# rejects the send.
CONTACT_FROM_EMAIL=contact@example.com


# --- Direct channels --------------------------------------------------------

# International format, digits only — no "+", no spaces. wa.me requires that.
# The WhatsApp card is hidden entirely while this is unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E.164 format WITH the leading "+", e.g. +9715XXXXXXXX. Drives the tel: link
# and the JSON-LD contact point. Hidden entirely while unset — a wrong phone
# number is worse than no phone number, because it reaches a stranger.
NEXT_PUBLIC_CONTACT_PHONE=

# Calendly scheduling link. The booking card is hidden while this is unset, and
# the hero's "Book a Meeting" button falls back to the channels section.
NEXT_PUBLIC_BOOKING_URL=


# --- Analytics --------------------------------------------------------------

# Google Analytics 4 measurement ID (Admin -> Data Streams -> Web).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Clarity project ID (Settings -> Overview).
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx

# Meta Pixel ID — called "Dataset ID" in Meta's current Events Manager.
# 15-16 digits. Public by design: it ships in the page source.
#
# Setting this ALSO changes the consent banner, which then offers a separate
# "Advertising" toggle. Measurement and advertising are different purposes and
# a visitor who agreed to one has not agreed to the other. Leave it unset
# unless you actually run Meta ads.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console verification token.
# Only needed if you verify by HTML tag rather than by DNS record.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Vercel Analytics and Speed Insights need no keys. They load only when
# NEXT_PUBLIC_VERCEL_ENV is present, which Vercel injects automatically on its
# own deployments — so they stay off locally and on any self-hosted build.


# --- Sanity CMS -------------------------------------------------------------
# Which source the project/availability content is read from.
#   local  = src/data/project.ts + src/config/availability.ts (the default)
#   sanity = the Sanity Content Lake
# Leave this on 'local' until you have reviewed the seeded content in Studio.
CONTENT_SOURCE=local

# Public by design — these three ship in the browser bundle. Sanity's access
# control lives on the dataset and on tokens, never on these values.
NEXT_PUBLIC_SANITY_PROJECT_ID=w5fmyzqc
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Viewer token. Only needed to preview unpublished drafts. No NEXT_PUBLIC_
# prefix: it must never reach the browser.
SANITY_API_READ_TOKEN=

# Shared with the Sanity webhook so /api/revalidate can verify its signature.
# Generate one with: [guid]::NewGuid().ToString()
SANITY_REVALIDATE_SECRET=

# Editor token, used ONLY by the one-time seed script from your own machine.
# Do not add this one to Vercel.
SANITY_WRITE_TOKEN=
