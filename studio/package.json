{
  "name": "ajix-studio",
  "private": true,
  "version": "1.0.0",
  "description": "AJIX content Studio — standalone, never bundled into the Next.js app.",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "schema:deploy": "sanity schema deploy",
    "typegen": "sanity schema extract && sanity typegen generate",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "seed:dry": "sanity exec scripts/seed.ts --with-user-token -- --dry-run"
  },
  "dependencies": {
    "@sanity/icons": "^5.4.0",
    "@sanity/vision": "6.24.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "6.24.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
